# ============================================
# AI4Bharat TTS Server Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
#
# NOTE (hardening/phase-0-critical-fixes): this service previously never
# called load_dotenv(), so this file had no effect even if present - that
# has been fixed in server.py. python-dotenv was already a declared
# dependency in requirements.txt but was unused.

# === Auth (SEC-07, hardening/phase-0-critical-fixes) ===
# Required - all TTS requests are rejected as unauthorized without a
# matching "api_key" field on the first WebSocket message. Must match
# TTS_SERVER_API_KEY in voice_2_voice_server/.env.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TTS_SERVER_API_KEY=CHANGE_ME_generate_a_real_key

# === Server Configuration ===
# These can also be set via --host/--port CLI arguments; see server.py.
# HOST=0.0.0.0
# PORT=8002
