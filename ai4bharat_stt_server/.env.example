# ============================================
# AI4Bharat STT Server Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# === HuggingFace Token (Optional) ===
# Required if the model is gated on HuggingFace
HF_TOKEN=your-huggingface-token

# === Server Configuration ===
# Port to run the server on (default: 8001)
# Can also be set via --port argument
PORT=8001

# === Auth (SEC-07, hardening/phase-0-critical-fixes) ===
# Required - /transcribe and /transcribe/bhili reject all requests without
# a matching X-API-Key header. Must match STT_SERVER_API_KEY in
# voice_2_voice_server/.env.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
STT_SERVER_API_KEY=CHANGE_ME_generate_a_real_key
