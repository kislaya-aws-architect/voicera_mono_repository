# ============================================
# Voice Server Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# === Vobiz Telephony API ===
VOBIZ_AUTH_ID=your-vobiz-auth-id
VOBIZ_AUTH_TOKEN=your-vobiz-auth-token
VOBIZ_API_BASE=https://api.vobiz.in/v1
VOBIZ_CALLER_ID=+91XXXXXXXXXX

# === Plivo Telephony API ===
# Runtime credentials should come from backend Integrations (PlivoAuthId / PlivoAuthToken).
# Keep these as optional placeholders for local reference only.
PLIVO_AUTH_ID=your-plivo-auth-id
PLIVO_AUTH_TOKEN=your-plivo-auth-token
PLIVO_API_BASE=https://api.plivo.com/v1
PLIVO_CALLER_ID=+91XXXXXXXXXX

# === Server URLs ===
# Public URL where this server is accessible (for Vobiz callbacks)
JOHNAIC_SERVER_URL=https://your-server-domain.com
# WebSocket URL prefix for audio streaming
JOHNAIC_WEBSOCKET_URL=wss://your-server-domain.com

# === Backend API ===
VOICERA_BACKEND_URL=http://localhost:8000
# Internal API key for secure service-to-service communication. Must be the
# SAME value as voicera_backend's INTERNAL_API_KEY (and the root .env) -
# hardening/phase-0-critical-fixes also reuses this to mint/verify signed
# WebSocket session tokens for /agent and /plivo/agent (see
# utils/security.py) and to gate /outbound/call/.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=CHANGE_ME_generate_a_real_key

# === CORS (hardening/phase-0-critical-fixes) ===
# Comma-separated list of real origins allowed to call this API from a
# browser. No wildcard fallback - unset means all cross-origin browser
# requests are rejected. Only relevant if a browser calls this service
# directly (e.g. local testing via /browser/agent).
ALLOWED_ORIGINS=http://localhost:3000

# === WebSocket / webhook hardening (hardening/phase-0-critical-fixes) ===
# Set to "false" to explicitly opt out (loudly logged) - default is on.
VOBIZ_WEBHOOK_VERIFICATION=true
PLIVO_WEBHOOK_VERIFICATION=true
# The /browser/agent/{agent_id} WebSocket is a dev/test entrypoint with no
# telephony webhook to mint a session token from - it is gated behind
# INTERNAL_API_KEY instead (pass it as ?token=... on the WebSocket URL).
# Set to "false" to disable this endpoint entirely in a real deployment.
ENABLE_BROWSER_TEST_ENDPOINT=true

# === Rate limiting stopgap (COST-01, hardening/phase-0-critical-fixes) ===
# Per-IP limits on the endpoints that directly cost money. slowapi syntax
# ("N/minute", "N/second", etc).
OUTBOUND_CALL_RATE_LIMIT=20/minute
ANSWER_WEBHOOK_RATE_LIMIT=60/minute

# === MinIO Storage ===
# Must match MINIO_ROOT_USER/MINIO_ROOT_PASSWORD in the root .env - the
# minioadmin/minioadmin default shown here previously was a real,
# publicly-known default credential pair; do not use it.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME_matches_MINIO_ROOT_USER
MINIO_SECRET_KEY=CHANGE_ME_matches_MINIO_ROOT_PASSWORD
MINIO_SECURE=false

# === Bhashini STT API ===
BHASHINI_API_KEY=your-bhashini-api-key
BHASHINI_SOCKET_URL=your-bhasini-wss-url

# === Bhashini Bhili STT (NVCF Triton gRPC) ===
# Required when agent language is bhb and STT provider is bhashini
BHASHINI_BHILI_STT_FUNCTION_ID=your-nvcf-function-uuid
BHASHINI_BHILI_STT_AUTH_TOKEN=your-nvapi-key
# Optional overrides (defaults shown)
# BHASHINI_BHILI_STT_GRPC_URL=grpc.nvcf.nvidia.com:443
# BHASHINI_BHILI_STT_FUNCTION_VERSION_ID=

# === External TTS/STT Services (if using local AI4Bharat servers) ===
AI4BHARAT_STT_URL=http://localhost:8001
AI4BHARAT_TTS_URL=http://localhost:8002
# INDIC_TTS_SERVER_URL=ws://localhost:8002
# INDIC_TTS_GAIN=1.5
# Required by ai4bharat_stt_server (SEC-07, hardening/phase-0-critical-fixes)
# - must match STT_SERVER_API_KEY in ai4bharat_stt_server/.env
STT_SERVER_API_KEY=CHANGE_ME_generate_a_real_key
# Required by ai4bharat_tts_server (SEC-07, hardening/phase-0-critical-fixes)
# - must match TTS_SERVER_API_KEY in ai4bharat_tts_server's environment
TTS_SERVER_API_KEY=CHANGE_ME_generate_a_real_key

# === Self-hosted LLM (llm_server / vLLM) ===
# Required by llm_server (SEC-06, hardening/phase-0-critical-fixes) - must
# match LLM_SERVER_API_KEY in llm_server's environment. Falls back to vLLM's
# no-op "EMPTY" key only if llm_server was explicitly launched with
# LLM_SERVER_ALLOW_NO_AUTH=true.
LLM_SERVER_API_KEY=CHANGE_ME_generate_a_real_key

# === Kenpath / Vistaar LLM ===
KENPATH_JWT_PRIVATE_KEY_PATH=services/kenpath_llm/jwt_private_key.pem
# KENPATH_JWT_PHONE=+91-9036722772
# KENPATH_VISTAAR_API_URL_PROD=https://voice-prod.mahapocra.gov.in
# KENPATH_VISTAAR_API_URL_DEV=https://vistaar-dev.mahapocra.gov.in
# KENPATH_VOICE_BHILI_URL=https://vistaar-dev.mahapocra.gov.in/api/voice-bhili

# === Bharat Vistaar LLM (Kenpath backend: bharatvistaar) ===
# Place prod_private_key_bh.pem in services/kenpath_llm/
BHARAT_VISTAAR_JWT_PRIVATE_KEY_PATH=services/kenpath_llm/prod_private_key_bh.pem
# BHARAT_VISTAAR_API_URL=https://chat-vistaar.da.gov.in
