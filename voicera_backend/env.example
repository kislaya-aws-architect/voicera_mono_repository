# MongoDB Configuration
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=admin
MONGODB_PASSWORD=admin123
MONGODB_DATABASE=voicera
MONGODB_AUTH_SOURCE=admin

# Application Configuration
DEBUG=False

# Security Configuration
SECRET_KEY=secret_key

# Mailtrap Configuration
MAILTRAP_API_TOKEN=your-mailtrap-api-token-here
MAILTRAP_FROM_EMAIL=noreply@voicera.com
MAILTRAP_FROM_NAME=Voicera
FRONTEND_URL=http://localhost:3000

# Internal API Key for service-to-service communication (bot -> backend)
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=your-internal-api-key-here

# MinIO Configuration
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Optional: override Chroma persistence root (default: voicera_backend/rag_system/chroma_data)
# CHROMA_BASE_DIR=/path/to/chroma_data

# Vobiz API Configuration
VOBIZ_API_BASE_URL=your-vobiz-base-url
VOBIZ_ACCOUNT_ID=your-vobiz-account-id
VOBIZ_AUTH_ID=your-vobiz-auth-id
VOBIZ_AUTH_TOKEN=your-vobiz-auth-token

# Sajag / Glific webhook (SaveLIFE Foundation WhatsApp integration) — PROVISIONAL
# Shared secret Glific must send back on every webhook call (see app/routers/glific.py).
# Placeholder until the Glific team confirms their actual signing/auth mechanism.
# Generate one for local testing: python -c "import secrets; print(secrets.token_urlsafe(32))"
SAJAG_GLIFIC_WEBHOOK_SECRET=your-glific-webhook-shared-secret

# ai4bharat_stt_server instance to use for transcribing Sajag voice notes
SAJAG_STT_SERVER_URL=http://localhost:8001

# llm_server (vLLM, OpenAI-compatible) instance to use for hazard classification
SAJAG_LLM_SERVER_URL=http://localhost:8003
SAJAG_LLM_MODEL=Qwen/Qwen3-8B
