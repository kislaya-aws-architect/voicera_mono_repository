# MongoDB Configuration
# hardening/phase-0-critical-fixes: these are now REQUIRED (the app will
# fail to start without them) and must NOT be left as weak/example values -
# use a real, strong password.
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=CHANGE_ME_mongo_username
MONGODB_PASSWORD=CHANGE_ME_use_a_strong_generated_password
MONGODB_DATABASE=voicera
MONGODB_AUTH_SOURCE=admin

# Application Configuration
DEBUG=False

# Security Configuration
# REQUIRED - the app will fail to start without this. Every replica/restart
# must use the SAME value (do not let this fall back to a generated one).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_generate_a_real_secret

# CORS - comma-separated list of real origins allowed to call this API from
# a browser (e.g. the frontend's URL). No wildcard is supported - see
# app/main.py. Requests with no ALLOWED_ORIGINS set will have all
# cross-origin browser calls rejected.
ALLOWED_ORIGINS=http://localhost:3000

# Mailtrap Configuration
MAILTRAP_API_TOKEN=your-mailtrap-api-token-here
MAILTRAP_FROM_EMAIL=noreply@voicera.com
MAILTRAP_FROM_NAME=Voicera
FRONTEND_URL=http://localhost:3000

# Internal API Key for service-to-service communication (bot -> backend).
# This same value must also be set as INTERNAL_API_KEY in
# voice_2_voice_server's .env - it is also reused there to mint/verify the
# signed WebSocket session tokens (see voice_2_voice_server/utils/security.py).
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=CHANGE_ME_generate_a_real_key

# MinIO Configuration - must match the MINIO_ROOT_USER/MINIO_ROOT_PASSWORD
# set in the root .env (see .env.example at the repo root)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_matches_MINIO_ROOT_USER
MINIO_SECRET_KEY=CHANGE_ME_matches_MINIO_ROOT_PASSWORD

# Optional: override Chroma persistence root (default: voicera_backend/rag_system/chroma_data)
# CHROMA_BASE_DIR=/path/to/chroma_data

# Vobiz API Configuration
VOBIZ_API_BASE_URL=your-vobiz-base-url
VOBIZ_ACCOUNT_ID=your-vobiz-account-id
VOBIZ_AUTH_ID=your-vobiz-auth-id
VOBIZ_AUTH_TOKEN=your-vobiz-auth-token
