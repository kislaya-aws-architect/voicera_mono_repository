# ============================================================
# Root .env - consumed by docker-compose.yml
# ============================================================
# Copy this file to .env in the repo root and fill in real values.
# hardening/phase-0-critical-fixes removed every hardcoded credential from
# docker-compose.yml (previously admin/admin123 for Mongo and
# minioadmin/minioadmin for MinIO, shipped in source). Compose will now
# refuse to start any service until these are set.
#
# These same values are also read by voicera_backend/.env and
# voice_2_voice_server/.env (or its own environment block in
# docker-compose.yml) - keep them consistent across files, they are the
# same credentials.

# --- MongoDB ---
# Generate a strong password, e.g.: python -c "import secrets; print(secrets.token_urlsafe(24))"
MONGO_ROOT_USERNAME=CHANGE_ME_mongo_username
MONGO_ROOT_PASSWORD=CHANGE_ME_use_a_strong_generated_password

# --- MinIO ---
MINIO_ROOT_USER=CHANGE_ME_minio_username
MINIO_ROOT_PASSWORD=CHANGE_ME_use_a_strong_generated_password

# --- Internal service-to-service API key ---
# Used by voicera_backend's X-API-Key dependency AND by
# voice_2_voice_server to mint/verify signed WebSocket session tokens (see
# voice_2_voice_server/utils/security.py). Must be the SAME value
# everywhere it's referenced.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=CHANGE_ME_generate_a_real_key

# ============================================================
# Note: MongoDB and MinIO ports are bound to 127.0.0.1 only by default in
# docker-compose.yml (not 0.0.0.0) - see the SECURITY NOTE at the top of
# that file. Do not remove that binding unless you have your own
# network-level access control in front of this host.
# ============================================================
